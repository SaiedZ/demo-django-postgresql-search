# --- PostgreSQL ---
DB_NAME=demo_search
DB_USER=demo
DB_PASSWORD=demo
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True

# --- Embeddings ---
# "local" = sentence-transformers model running on this machine (no network call).
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the dimension of the chosen model (all-MiniLM-L6-v2 => 384).
# Changing the model requires a new migration on the Article.embedding field.
EMBEDDING_DIM=384
